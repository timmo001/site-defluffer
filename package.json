{
  "name": "site-defluffer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@timmo001/oxlint-rules": "0.7.1",
    "@types/chrome": "0.3.7",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint-plugin-lit": "2.3.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@timmo001/groundwork-tokens": "0.51.0",
    "@timmo001/groundwork-ui": "0.51.0",
    "lit": "3.3.3"
  }
}
